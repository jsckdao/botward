{
  "name": "botward",
  "version": "0.1.1",
  "description": "A minimal single-task AI agent CLI for unsupervised tasks (e.g. webhook handlers)",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "botward": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "commander": "^12.1.0",
    "openai": "^4.70.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "anthropic",
    "openai",
    "claude",
    "gpt",
    "llm",
    "automation",
    "webhook",
    "zod"
  ],
  "author": {
    "name": "jsckdao",
    "url": "https://github.com/jsckdao"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsckdao/botward.git"
  },
  "bugs": {
    "url": "https://github.com/jsckdao/botward/issues"
  },
  "homepage": "https://github.com/jsckdao/botward#readme",
  "private": false
}
